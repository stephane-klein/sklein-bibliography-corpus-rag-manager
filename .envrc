export PROJECT_NAME="sklein-bibliography-corpus-rag-manager"
export INSTANCE_ID=$(pwd | sha1sum | awk '{print $1}' | cut -c 1-12)
export COMPOSE_PROJECT_NAME=${PROJECT_NAME}_${INSTANCE_ID}

export SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_ADMIN_TOKEN="change-me-to-a-random-64-hex-token"

export SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_EMBEDDING_PROVIDER=voyage
export SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_EMBEDDING_MODEL=voyage-4
export SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_EMBEDDING_QUERY_MODEL=voyage-4-lite
export SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_EMBEDDING_DIMENSION=1024

# Load local-only secrets from .secret when present (the file is git-ignored).
if [ -f .secret ]; then
  set -a
  . ./.secret
  set +a
fi

# Read .pitchfork-webapp-port to set webapp port in SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_API_URL
_webapp_port_file="${MISE_CONFIG_ROOT:-$PWD}/.pitchfork-webapp-port"

if [ -f "$_webapp_port_file" ]; then
  _webapp_port=$(cat "$_webapp_port_file")
fi

if [ -n "$_webapp_port" ]; then
  export SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_API_URL="${SKLEIN_BIBLIOGRAPHY_CORPUS_RAG_MANAGER_API_URL:-http://localhost:$_webapp_port}"
fi

unset _webapp_port _webapp_port_file

export NODE_TLS_REJECT_UNAUTHORIZED=0

export SMTP_HOST="${SMTP_HOST:-127.0.0.1}"
export SMTP_PORT="${SMTP_PORT:-1025}"
export SMTP_USER=""
export SMTP_PASS=""
export EMAIL_FROM="noreply@example.com"
export TEST_EMAIL_TO="john.doe@example.com"
